# =====================================================================
# AutoTube AI - Configuration & API Keys (100% Free Stack)
# =====================================================================

# 1. AI Scriptwriter (Get free key at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. AI Scriptwriter Fallback (Optional, free key at: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# 3. Stock Footage Videos (Free key at: https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_api_key_here

# 4. YouTube Channel API (From Google Cloud Console: https://console.cloud.google.com/)
# NOTE: You can also connect channels directly via the Web Dashboard with 1 click!
YT_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
YT_CLIENT_SECRET=your_client_secret_here
YT_REFRESH_TOKEN=your_refresh_token_here

# 5. Video & Voice Preferences (Optional)
# Edge-TTS Free Neural Voices: en-US-ChristopherNeural, en-US-GuyNeural, en-US-AndrewNeural, en-US-JennyNeural
EDGE_TTS_VOICE=en-US-ChristopherNeural
YT_PRIVACY_STATUS=public
